# Comma-separated allowed CORS origins for the frontend. "*" (default) is
# fine for local dev only.
ALLOWED_ORIGINS=*

# "local" (default) or a hosted provider you've wired up - see
# app/pipeline/moderation.py
MODERATION_PROVIDER=local

# Must match INTERNAL_API_SECRET in the frontend's .env.local. Leave unset
# for local dev - see the note in app/main.py's module docstring.
INTERNAL_API_SECRET=

# Cloud Storage bucket the browser uploads videos to directly, instead of
# posting them here - see app/uploads.py. Leave unset for local dev (files
# are posted to this server as before).
GCS_UPLOAD_BUCKET=
