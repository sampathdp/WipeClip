{
  "name": "wipeclip",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,magenta \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "next dev",
    "dev:backend": "node scripts/dev-backend.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seo:check": "node scripts/seo-check.mjs",
    "newsletter": "node --experimental-strip-types --no-warnings --env-file=.env.local scripts/send-newsletter.ts",
    "desktop:dev": "node desktop/scripts/tauri.mjs dev",
    "desktop:build": "node desktop/scripts/tauri.mjs build",
    "desktop:frontend:dev": "next dev desktop --port 3100",
    "desktop:release": "node desktop/scripts/release-local.mjs",
    "desktop:frontend:build": "next build desktop && node desktop/scripts/check-bundle.mjs",
    "desktop:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "desktop:test:js": "node --experimental-strip-types --no-warnings --test \"tests/desktop/*.test.*\"",
    "dev:setup": "node scripts/dev-setup.mjs",
    "dev:check": "node scripts/dev-check.mjs",
    "dev:smoke": "node scripts/dev-smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@huggingface/transformers": "^4.3.1",
    "@paddle/paddle-js": "^1.6.5",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-deep-link": "^2.6.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^16.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "undici": "^6.28.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "fake-indexeddb": "^6.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
