{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WipeClip",
  "version": "0.1.3",
  "identifier": "co.wipeclip.desktop",
  "build": {
    "frontendDist": "../desktop/out",
    "devUrl": "http://localhost:3100",
    "beforeDevCommand": "npm run desktop:frontend:dev",
    "beforeBuildCommand": "npm run desktop:frontend:build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "capabilities": ["main", "mini"],
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data: asset: http://asset.localhost",
        "media-src": "'self' blob: asset: http://asset.localhost",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost blob: data: https://www.wipeclip.co https://*.supabase.co wss://*.supabase.co https://huggingface.co https://*.huggingface.co https://*.hf.co https://cdn.jsdelivr.net",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "publisher": "WipeClip",
    "copyright": "© WipeClip.co",
    "category": "Video",
    "fileAssociations": [
      {
        "ext": ["wipeclip"],
        "name": "WipeClip project",
        "description": "WipeClip project",
        "role": "Editor",
        "mimeType": "application/x-wipeclip-project",
        "rank": "Owner",
        "exportedType": {
          "identifier": "co.wipeclip.project",
          "conformsTo": ["public.zip-archive", "public.data"]
        }
      }
    ],
    "shortDescription": "WipeClip video editor",
    "longDescription": "Trim, cut, add transitions, text, stickers, filters and music, and remove unwanted objects from your own footage with AI.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["wipeclip"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1MTlGRDRFMjU3Q0Y3REYKUldUZjkzd2xUdjBaZGUrS25YV09IamlWVDNvOUhZSDluWXdRVjArS253VUxaWkZQVkI1eGMyVFoK",
      "endpoints": ["https://github.com/sampathdp/wipeclip-releases/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
