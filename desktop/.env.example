# Desktop frontend build settings (copy to desktop/.env.production.local).
# Everything here is compiled into the app and readable by anyone who has
# it - only public values belong here. Never put SUPABASE_SERVICE_ROLE_KEY,
# INTERNAL_API_SECRET, payment keys or any other server secret in this file.

# The website the app calls for accounts, credits and job tickets.
NEXT_PUBLIC_DESKTOP_SITE_ORIGIN=https://www.wipeclip.co

# Same public values as the website's production build.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_TOOLS_API_URL=
