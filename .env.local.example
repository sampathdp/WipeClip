# URL of the FastAPI backend (backend/), e.g. from `uvicorn app.main:app --reload --port 8001`
NEXT_PUBLIC_TOOLS_API_URL=http://localhost:8001

# Supabase (Project Settings -> API). Anon key is public by design; the
# service role key bypasses Row Level Security - never expose it to the
# client or commit it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Lemon Squeezy (Settings -> API for the key, Settings -> Webhooks for the
# signing secret when you create a webhook pointed at
# https://<your-domain>/api/webhooks/lemonsqueezy). Variant IDs come from
# each product's pricing/variant page once the Starter/Pro/PAYG products
# are created in the LS dashboard.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_STARTER=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_PAYG=

# Used as the checkout redirect_url base; falls back to the request's own
# origin if unset, but set this explicitly in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" to show the /under-construction page to every visitor
# instead of the real site (pages + Server Actions only - /api and /auth
# routes still work so sign-in and webhooks keep functioning). Visiting
# with ?bypass=<SITE_BYPASS_SECRET> once skips the gate for that browser
# (sets a cookie) so you can keep testing the real site yourself.
SITE_UNDER_CONSTRUCTION=false
SITE_BYPASS_SECRET=

# Shared secret between this app's /api/process route and the FastAPI
# backend's /api/video/process - stops that endpoint from being called
# directly (which would skip the credit check entirely). Set the same
# value here and as INTERNAL_API_SECRET in backend/.env. Generate with
# e.g. `openssl rand -hex 32`. Leave both unset for local dev.
INTERNAL_API_SECRET=
