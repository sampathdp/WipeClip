# URL of the FastAPI backend (backend/), e.g. from `uvicorn app.main:app --reload --port 8001`
NEXT_PUBLIC_TOOLS_API_URL=http://localhost:8001

# Supabase (Project Settings -> API). Anon key is public by design; the
# service role key bypasses Row Level Security - never expose it to the
# client or commit it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payments.lk (https://payments.lk/developers/guide). Dashboard ->
# Developers -> Create sandbox secret key (starts sk_test_; swap for the
# sk_live_ key once approved - nothing else changes). Add a webhook endpoint
# pointed at https://<your-domain>/api/webhooks/payments-lk and paste its
# signing secret (whsec_...) below. Server-only - never expose these.
PAYMENTS_LK_SECRET_KEY=
PAYMENTS_LK_WEBHOOK_SECRET=

# Paddle (https://developer.paddle.com) - checkout for everyone outside Sri
# Lanka. Until all three keys are set, every visitor gets Payments.lk. The
# key prefixes pick the environment: sandbox is pdl_sdbx_apikey_... + test_...,
# live is pdl_live_apikey_... + live_... - both must be the same environment.
# Going live = swapping every PADDLE_* value below for its live counterpart.
# Server-only except the client token, which /api/checkout hands to Paddle.js.
#   API key:       Developer tools -> Authentication -> API keys
#   Client token:  Developer tools -> Authentication -> Client-side tokens
#   Webhook secret: Developer tools -> Notifications -> your destination's
#                   secret key (pdl_ntfset_...), destination URL
#                   https://<your-domain>/api/webhooks/paddle, event
#                   transaction.completed
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
# One-time (no billing cycle) USD prices, one per plan, matching usdCents in
# src/lib/credits.ts. Sandbox and live IDs differ.
PADDLE_PRICE_LITE=
PADDLE_PRICE_LITE_YEARLY=
PADDLE_PRICE_STARTER=
PADDLE_PRICE_STARTER_YEARLY=
PADDLE_PRICE_PRO=
PADDLE_PRICE_PRO_YEARLY=
PADDLE_PRICE_PAYG=
PADDLE_PRICE_CREATOR=
# Header holding the webhook sender's IP, checked against Paddle's published
# IPs (fetched from /ips, never hard-coded). x-real-ip on Vercel; use
# cf-connecting-ip if Cloudflare proxies the site.
PADDLE_WEBHOOK_IP_HEADER=x-real-ip
# Forces the visitor country for picking the checkout (LK = Payments.lk,
# anything else = Paddle). For local testing only - leave unset in production.
CHECKOUT_COUNTRY=

# Used as the checkout successUrl/cancelUrl base; falls back to the request's own
# origin if unset, but set this explicitly in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" to show the /under-construction page to every visitor
# instead of the real site (pages + Server Actions only - /api and /auth
# routes still work so sign-in and webhooks keep functioning). Visiting
# with ?bypass=<SITE_BYPASS_SECRET> once skips the gate for that browser
# (sets a cookie) so you can keep testing the real site yourself.
SITE_UNDER_CONSTRUCTION=false
SITE_BYPASS_SECRET=

# Shared secret between this app's /api/process route and the FastAPI
# backend's /api/video/process - stops that endpoint from being called
# directly (which would skip the credit check entirely). Set the same
# value here and as INTERNAL_API_SECRET in backend/.env. Generate with
# e.g. `openssl rand -hex 32`. Leave both unset for local dev.
INTERNAL_API_SECRET=

# Email notifications for /feedback submissions (bug reports, feature
# requests) via Resend (https://resend.com -> API Keys). Without a verified
# domain, Resend can only deliver to the email you signed up to Resend with,
# so sign up with the same address as FEEDBACK_NOTIFY_EMAIL. Once you verify
# a domain, set EMAIL_FROM to e.g. "WipeClip <feedback@wipeclip.co>".
# Leave RESEND_API_KEY unset to skip emails (feedback is still saved).
RESEND_API_KEY=
EMAIL_FROM=
FEEDBACK_NOTIFY_EMAIL=
